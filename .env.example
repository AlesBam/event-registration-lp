# URL nasazené Google Apps Script Web App (končí na /exec).
# Najdeš ji v Apps Script editoru: Nasadit → Spravovat nasazení → Webová aplikace → URL.
#
# NENÍ to tajemství: začíná NEXT_PUBLIC_, takže ji Next.js vloží do klientského
# JavaScriptu a uvidí ji každý návštěvník. Bezpečnost stojí na logice ve skriptu
# (validace, uzávěrka, duplicity, honeypot), ne na utajení URL.
#
# Používá ji prohlížeč (POST registrace) i Next.js server (GET počet přihlášených).
# Při změně ve Vercelu je nutný nový deploy, protože hodnota se vkládá při buildu.
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
